APP_ENV=development
DRY_RUN=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://cs2bot:password@postgres:5432/cs2tradeup
REDIS_URL=redis://redis:6379/0

BYMYKEL_BASE_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en

BUFF_BASE_URL=
BUFF_API_KEY=
BUFF_API_SECRET=
BUFF_RATE_LIMIT_PER_MINUTE=60

DISCORD_WEBHOOK_URL=
DISCORD_MENTION_USER_ID=
DISCORD_MENTION_ROLE_ID=

STEAMAPIS_API_KEY=
# Disabled-by-default manual real SteamApis offer smoke.
ENABLE_LIVE_STEAMAPIS_SMOKE=false

STEAMDT_BASE_URL=https://open.steamdt.com
STEAMDT_API_KEY=
# Deprecated compatibility setting; SteamDT request control now uses endpoint-specific limits below.
STEAMDT_RATE_LIMIT_PER_MINUTE=60
STEAMDT_RATE_LIMIT_PRICE_SINGLE_PER_MINUTE=60
STEAMDT_RATE_LIMIT_PRICE_BATCH_PER_MINUTE=1
# Internal safety cap; official SteamDT limit is not documented in the permissions table.
STEAMDT_RATE_LIMIT_PRICE_AVG_PER_MINUTE=10
STEAMDT_RATE_LIMIT_BASE_PER_DAY=1
STEAMDT_RATE_LIMIT_KLINE_PER_MINUTE=120
STEAMDT_RATE_LIMIT_WEAR_PER_HOUR=36000
# Project safety buffer for the 1/min batch endpoint; not part of the official quota.
STEAMDT_RATE_LIMIT_PRICE_BATCH_SAFETY_BUFFER_SECONDS=5
# Explicit SteamDT limiter composition backend: inmemory (default) or redis.
STEAMDT_RATE_LIMIT_BACKEND=inmemory
STEAMDT_RATE_LIMIT_REDIS_NAMESPACE=steamdt-rate-limit-v1
# Explicit SteamDT price-cache composition backend: inmemory (default) or redis.
STEAMDT_PRICE_CACHE_BACKEND=inmemory
STEAMDT_PRICE_CACHE_REDIS_NAMESPACE=steamdt-price-cache-v1
STEAMDT_DRY_RUN=true
# Dedicated one-request selector-before snapshot smoke; disabled by default.
STEAMDT_RUN_PRICE_SNAPSHOT_SMOKE=false
STEAMDT_RUN_BUFF_PROVIDER_SMOKE=false
# Double gate for the manual refresh integration command's --mode live path.
STEAMDT_RUN_REFRESH_INTEGRATION=false
STEAMDT_SMOKE_MARKET_HASH_NAME=
STEAMDT_SMOKE_MARKET_HASH_NAMES=
STEAMDT_ENABLE_AVG_SANITY_CHECK=false
STEAMDT_MAX_PRICE_TO_AVG_RATIO=1.50
STEAMDT_AVG_SANITY_FALLBACK_TO_LOWEST_POSITIVE=false
STEAMDT_PROVIDER_BATCH_MODE=false
STEAMDT_PROVIDER_MAX_AVG_REQUESTS_PER_BATCH=10
STEAMDT_RUN_REDIS_INTEGRATION_TESTS=false
STEAMDT_TEST_REDIS_URL=redis://localhost:6379/15
STEAMDT_TEST_REDIS_NAMESPACE=steamdt-rate-limit-integration-v1
# Separate opt-in for real Redis price-cache Lua/integration validation.
STEAMDT_RUN_REDIS_PRICE_CACHE_INTEGRATION_TESTS=false
STEAMDT_TEST_REDIS_PRICE_CACHE_NAMESPACE=steamdt-price-cache-integration-v1

SCAN_HIGH_PRIORITY_INTERVAL_SECONDS=60
SCAN_NORMAL_INTERVAL_SECONDS=300
SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=86400
SCHEDULER_CLEANUP_INTERVAL_SECONDS=86400
SCHEDULER_RUN_ON_STARTUP=false
SCHEDULER_MAX_INSTANCES=1

SELL_FEE_RATE=0.025
MIN_ROI=0.05
MIN_EXPECTED_PROFIT_CNY=20
MAX_WORST_CASE_LOSS_PCT=0.25
MIN_PROFIT_PROBABILITY=0.35
MAX_INPUT_TOTAL_COST_CNY=1000
